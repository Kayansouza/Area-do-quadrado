
// Escreva um programa em que o usuário informe dois números. Então escreva em tela o maior deles.


programa {
  funcao inicio() {
    inteiro maior, numero
    
    escreva ("Digite o numero MAIOR: ")
    leia (numero)

    se ( numero < 50) {
      escreva ("esse numero nao e o maior")
    }

    senao ("esse numero e o maior")

    escreva ("\n")

  }
}


// Validando numero

programa {
  funcao inicio() {
    inteiro numero

    escreva ("Digite um numero:" )
    leia (numero)

    se (numero > 0) {
      escreva ("O numero é positivo")
    }

    senao {
      escreva ("O numero é negativo")
    }


  // Faça um programa para ler 3 valores (considere que não serão informados valores iguais) e escrever o maior deles.

   inteiro numero

    escreva ("digite um numero: ")
    leia (numero)

    se (numero > 20) {
      escreva ("Maior")
    }

    senao se (numero >= 19 e numero <= 100) {
      escreva (" Médio")
    }

    senao {
      escreva ("esse é o menor numero")
    }


    // 
  }
}
